# Absolute base URL used for canonical links, hreflang, sitemap.xml, robots.txt
# and Open Graph images. aibani.health is the decided-in-principle production
# domain (docs/specs/07-seo-strategy.md) — availability/final migration is
# Phase 10 of docs/specs/12-roadmap.md. Leave unset locally/in CI to use that
# default; set explicitly once the domain is live.
NEXT_PUBLIC_SITE_URL=https://aibani.health

# Plausible analytics domain (docs/specs/09-analytics-tracking.md). No account
# exists yet — see docs/decisions/0011-analytics-plausible-inactive-until-configured.md.
# Leave unset: no script loads, no events fire, no error. Set it once a real
# Plausible domain/account exists (self-hosted instance or plausible.io site id).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
